{
  "routes": [
    { "src": "/images/(.*)", "dest": "/images/$1", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/static/(.*)", "dest": "/static/$1", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/[^.]+", "dest": "/", "status": 200 }
  ],
  "buildCommand": "npm run vercel-build"
} 